<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <ObfuscarEnabled Condition="'$(ObfuscarEnabled)' == ''">true</ObfuscarEnabled>
    <Obfuscator_ConfigTemplate_ProjectReferences_Append Condition="'$(Obfuscator_ConfigTemplate_ProjectReferences_Append)' == ''">true</Obfuscator_ConfigTemplate_ProjectReferences_Append>
    <Obfuscator_Diagnostics_TempFolder_Delete Condition="'$(Obfuscator_Diagnostics_TempFolder_Delete)' == ''">true</Obfuscator_Diagnostics_TempFolder_Delete>
  </PropertyGroup>

  <PropertyGroup>
    <ObfuscarMsBuildTasksAssembly Condition="'$(ObfuscarMsBuildTasksAssembly)' == '' AND Exists('$(MSBuildThisFileDirectory)..\tools\Obfuscar.MsBuild.Tasks.dll')">$(MSBuildThisFileDirectory)..\tools\Obfuscar.MsBuild.Tasks.dll</ObfuscarMsBuildTasksAssembly>
    <ObfuscarMsBuildTasksAssembly Condition="'$(ObfuscarMsBuildTasksAssembly)' == '' AND Exists('$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net472\Obfuscar.MsBuild.Tasks.dll')">$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net472\Obfuscar.MsBuild.Tasks.dll</ObfuscarMsBuildTasksAssembly>
    <ObfuscarMsBuildTasksAssembly Condition="'$(ObfuscarMsBuildTasksAssembly)' == '' AND Exists('$(MSBuildThisFileDirectory)..\bin\Release\net472\Obfuscar.MsBuild.Tasks.dll')">$(MSBuildThisFileDirectory)..\bin\Release\net472\Obfuscar.MsBuild.Tasks.dll</ObfuscarMsBuildTasksAssembly>
    <ObfuscarMsBuildTasksAssembly Condition="'$(ObfuscarMsBuildTasksAssembly)' == '' AND Exists('$(MSBuildThisFileDirectory)..\bin\Debug\net472\Obfuscar.MsBuild.Tasks.dll')">$(MSBuildThisFileDirectory)..\bin\Debug\net472\Obfuscar.MsBuild.Tasks.dll</ObfuscarMsBuildTasksAssembly>
  </PropertyGroup>

  <UsingTask TaskName="Obfuscate" AssemblyFile="$(ObfuscarMsBuildTasksAssembly)" Condition="'$(ObfuscarMsBuildTasksAssembly)' != ''" />

  <Target Name="ResolveObfuscarConsole">
    <PropertyGroup>
      <_NuGetPackageRootWithSlash Condition="'$(NuGetPackageRoot)' != ''">$([MSBuild]::EnsureTrailingSlash($(NuGetPackageRoot)))</_NuGetPackageRootWithSlash>
      <Obfuscator_Path Condition="'$(Obfuscator_Path)' == '' AND '$(Obfuscar)' != '' AND Exists('$(Obfuscar)')">$(Obfuscar)</Obfuscator_Path>
    </PropertyGroup>

    <ItemGroup Condition="'$(Obfuscator_Path)' == '' OR !Exists('$(Obfuscator_Path)')">
      <_ObfuscarConsoleExe Include="$(_NuGetPackageRootWithSlash)obfuscar\**\Obfuscar.Console.exe" Condition="'$(_NuGetPackageRootWithSlash)' != ''" />
      <_ObfuscarConsoleExe Include="$(MSBuildThisFileDirectory)..\..\obfuscar\**\Obfuscar.Console.exe" />
      <_ObfuscarConsoleExe Include="$(SolutionDir)packages\Obfuscar.*\tools\Obfuscar.Console.exe" Condition="'$(SolutionDir)' != '' AND '$(SolutionDir)' != '*Undefined*'" />
    </ItemGroup>

    <PropertyGroup>
      <Obfuscator_Path Condition="('$(Obfuscator_Path)' == '' OR !Exists('$(Obfuscator_Path)')) AND '@(_ObfuscarConsoleExe)' != ''">@(_ObfuscarConsoleExe->Last())</Obfuscator_Path>
    </PropertyGroup>
  </Target>

  <Target Name="ObfuscarObfuscate"
          AfterTargets="Build"
          DependsOnTargets="ResolveObfuscarConsole"
          Condition="'$(ObfuscarEnabled)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false' AND '$(TargetFileName)' != '' AND '$(ObfuscarMsBuildTasksAssembly)' != ''">
    <Error Condition="'$(Obfuscator_Path)' == '' OR !Exists('$(Obfuscator_Path)')"
           Text="Unable to locate Obfuscar.Console.exe. Restore packages so the Obfuscar dependency is available, or set Obfuscator_Path / Obfuscar." />

    <Obfuscate
      Obfuscator_Path="$(Obfuscator_Path)"
      Obfuscator_ConfigTemplate="$(Obfuscator_ConfigTemplate)"
      Obfuscator_ConfigTemplate_ProjectReferences_Append="$(Obfuscator_ConfigTemplate_ProjectReferences_Append)"
      Obfuscator_Targets="$(Obfuscator_Targets)"
      ConfigurationName="$(Configuration)"
      SolutionDir="$(SolutionDir)"
      SolutionFileName="$(SolutionFileName)"
      SolutionName="$(SolutionName)"
      ProjectDir="$(ProjectDir)"
      ProjectFileName="$(MSBuildProjectFile)"
      ProjectName="$(ProjectName)"
      ProjectReferences="@(ReferencePath)"
      TargetDir="$(TargetDir)"
      TargetFileName="$(TargetFileName)"
      TargetName="$(TargetName)"
      Diagnostics_TempFolder_Delete="$(Obfuscator_Diagnostics_TempFolder_Delete)" />
  </Target>

</Project>
