<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\__SHARED\Shared.targets" />

	<PropertyGroup>
		<PackageId>Obfuscar.MsBuild</PackageId>
		<DevelopmentDependency>true</DevelopmentDependency>
		<Description>Build targets interface for Obfuscar</Description>
		<PackageTags>Obfuscar MSBuild Targets</PackageTags>
		<Authors>Enner Pérez, Tony Valenti</Authors>
		<Version>2.2.52.0</Version>

		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/ennerperez/msbuild-obfuscar</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ennerperez/msbuild-obfuscar</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<PackageIcon>.editoricon.png</PackageIcon>
		<PackageIconUrl />
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<PackageReleaseNotes>Includes 'Obfuscar' v2.2.50 in a solution-level NuGet package</PackageReleaseNotes>
	</PropertyGroup>

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<NoWarn>$(NoWarn);NU5128</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Obfuscar" Version="2.2.50">
			<PrivateAssets>none</PrivateAssets>
			<IncludeAssets>all</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\.editoricon.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="README.md" Pack="True" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<None Include="build\*.targets" Visible="True" Pack="True" PackagePath="build\Obfuscar.MsBuild.targets" />
		<None Include="build\*.props" Visible="True" Pack="True" PackagePath="build\Obfuscar.MsBuild.props" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Obfuscar.MsBuild.Tasks\Obfuscar.MsBuild.Tasks.csproj">
			<PrivateAssets>all</PrivateAssets>
		</ProjectReference>
	</ItemGroup>

	<Target Name="PackObfuscarMsBuildTasks" BeforeTargets="_GetPackageFiles">
		<ItemGroup>
			<None Include="$(TargetDir)Obfuscar.MsBuild.Tasks.dll" Pack="True" PackagePath="tools" Visible="False" />
			<None Include="$(TargetDir)Obfuscar.MsBuild.Tasks.pdb" Pack="True" PackagePath="tools" Visible="False" Condition="Exists('$(TargetDir)Obfuscar.MsBuild.Tasks.pdb')" />
		</ItemGroup>
	</Target>

</Project>
